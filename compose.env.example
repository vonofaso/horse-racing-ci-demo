# Copy this file to .env.compose and fill in both passwords.
# .env.compose is ignored by Git. Do not commit actual passwords.
POSTGRES_DB=horse_racing
APP_DB_USER=horse
# Use separate random passwords. APP_DB_PASSWORD is part of a connection URL:
# use letters/digits/underscore/hyphen (for example secrets.token_hex(24)).
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

APP_IMAGE=horse-racing:lab4
APP_BIND_IP=127.0.0.1
APP_PUBLISHED_PORT=8000
